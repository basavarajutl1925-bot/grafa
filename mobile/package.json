{
  "name": "grafa-mobile",
  "version": "1.0.0",
  "description": "Location-based ads and price prediction mobile app",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build --platform android --type apk",
    "build:aab": "eas build --platform android --type app-bundle",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "build:local": "cd android && ./gradlew assembleRelease && cd ..",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-native-community/geolocation": "^2.0.2",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.16",
    "@react-native-async-storage/async-storage": "^1.17.11",
    "axios": "^1.4.0",
    "react": "18.2.0",
    "react-native": "^0.73.0",
    "react-native-device-info": "^10.3.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-image-picker": "^5.3.1",
    "react-native-maps": "1.8.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-permissions": "^3.10.0",
    "react-native-safe-area-context": "^4.5.3",
    "react-native-screens": "^3.21.0",
    "react-native-uuid": "^2.0.1",
    "expo": "^50.0.0",
    "expo-location": "^16.0.0",
    "expo-constants": "^15.0.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.73.2",
    "eas-cli": "^6.0.0",
    "@react-native/metro-config": "^0.83.1",
    "jest": "^29.5.0"
  }
}
